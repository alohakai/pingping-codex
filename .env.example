# 飞书企业自建应用凭证。不要提交真实值。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# 可选白名单；逗号分隔。留空表示不限制。
FEISHU_ALLOWED_USERS=
FEISHU_ALLOWED_CHATS=

# Codex CLI。默认会自动查找 Codex 桌面应用内置二进制。
CODEX_BINARY=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request

# Master 对话的工作目录和额外可访问项目。
CODEX_MASTER_CWD=/absolute/path/to/pingping-codex
CODEX_PROJECTS_FILE=config/projects.json
CODEX_MEMORY_DIR=memory

# 本地状态和日志。
STATE_DB=data/state.db
LOG_LEVEL=INFO
FEISHU_REPLY_MAX_CHARS=12000
