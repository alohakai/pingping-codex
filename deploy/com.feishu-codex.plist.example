<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.feishu-codex</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/absolute/path/to/pingping-codex/scripts/run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/absolute/path/to/pingping-codex</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/absolute/path/to/pingping-codex/logs/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/absolute/path/to/pingping-codex/logs/stderr.log</string>
</dict>
</plist>
